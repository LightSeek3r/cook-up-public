# Headers for static assets (static/ and /_app), which the Workers asset layer
# serves without running hooks.server.ts. Kept identical to
# src/lib/securityHeaders.ts by src/lib/securityHeaders.test.mjs.
#
# Here at the project root, not in static/: adapter-cloudflare refuses to build
# with a static/_headers, copies this file into .svelte-kit/cloudflare/_headers
# and appends its own /_app rules after it. Matching rules are merged, so the
# /* rule sets no Cache-Control: the adapter's immutable caching of
# /_app/immutable/* stays as it is.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# The data artefacts the home page matches with in the browser. It fetches them
# as /data/...?v=<data version>, a hash of their content, so a URL never names
# two contents; a stale copy (a request that raced a deploy, since the assets
# ignore the query) is caught by the version check in src/lib/client.
# core.bin's Content-Type is one Cloudflare compresses (verified on
# workers.dev, 2026-10-14: brotli 183 KB); as application/octet-stream it went
# out raw, 434 KB. Only fetch() reads it, as bytes, so the type is never acted on.
/data/core.bin
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/x-protobuf
/data/names/*
  Cache-Control: public, max-age=31536000, immutable
/data/titles/*
  Cache-Control: public, max-age=31536000, immutable
