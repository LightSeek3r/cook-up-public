{
  "name": "cook-up",
  "version": "0.1.2",
  "description": "Ingredients-first recipe finder: pick what you have, get recipes ranked by how few ingredients you are missing. SvelteKit on Cloudflare Workers.",
  "license": "MIT",
  "author": "LightSeek3r",
  "homepage": "https://www.unit42.fr/cook-up",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LightSeek3r/cook-up-public.git"
  },
  "bugs": {
    "url": "https://github.com/LightSeek3r/cook-up-public/issues"
  },
  "keywords": [
    "recipes",
    "ingredients",
    "sveltekit",
    "cloudflare-workers",
    "i18n",
    "nutrition"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:checked": "node scripts/build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "release": "node scripts/release.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:eol": "node scripts/check-line-endings.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "data:fetch": "node scripts/data-fetch.mjs",
    "data:check": "node scripts/data-fetch.mjs --check",
    "data:build": "node pipeline/09_build_artefacts.mjs",
    "data:publish": "node pipeline/tools/publish_artefacts.mjs",
    "data:parity:remote": "node pipeline/tools/artefact_remote_parity.mjs",
    "test:e2e": "playwright test",
    "preview": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply cook-up-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cook-up-db --remote",
    "db:translate:manual": "node pipeline/tools/apply_manual_translations.mjs",
    "glossary:status": "node pipeline/tools/glossary_status.mjs",
    "glossary:validate": "vitest run pipeline/lib/glossary_gate.test.mjs pipeline/lib/glossary_content.test.mjs",
    "recipe-i18n:status": "node pipeline/tools/recipe_i18n_status.mjs",
    "recipe-i18n:mirror": "node pipeline/tools/recipe_i18n_mirror.mjs",
    "pipeline:fetch": "node pipeline/01_fetch.mjs",
    "pipeline:parse": "node pipeline/02_parse.mjs",
    "pipeline:normalize": "node pipeline/03_normalize_ingredients.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
